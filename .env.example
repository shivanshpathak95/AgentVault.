# =============================================================================
# AgentVault — environment template
# =============================================================================
# Copy to the right place and fill in. NOTHING here has a hardcoded fallback in
# source: a missing required variable is a startup crash with a named error.
#
#   cp .env.example apps/web/.env.local
#   cp .env.example apps/agent/.env
#   cp .env.example apps/service/.env
#   cp .env.example contracts/.env
#
# Never commit a filled-in copy. .gitignore already excludes .env*.
# =============================================================================


# -----------------------------------------------------------------------------
# NETWORK — Arc
# -----------------------------------------------------------------------------
# Verify every value against https://docs.arc.io/arc/references/rpc-endpoints
# before a mainnet deploy. Do not trust third-party listings for the chain id.
#
#   Arc mainnet : chainId 5042     rpc https://rpc.mainnet.arc.io   explorer https://explorer.arc.io
#   Arc testnet : chainId 5042002  rpc https://rpc.testnet.arc.io   explorer https://explorer.testnet.arc.io
#
# 5042 and 5042002 differ by three characters. Getting this wrong signs real
# transactions for the wrong network. There is no default; set it explicitly.

NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_NETWORK_NAME=Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_WS_URL=wss://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io


# -----------------------------------------------------------------------------
# USDC
# -----------------------------------------------------------------------------
# On Arc, USDC is the native gas asset AND an ERC-20.
#
#   native      : 18 decimals  — used for GAS only
#   ERC-20 iface:  6 decimals  — used for ALL vault accounting and transfers
#
# Mixing them is a 10^12x error. AgentVault only ever touches the ERC-20
# interface. The native balance is read for gas display and nothing else.
#
# The ERC-20 interface address is the same on mainnet and testnet, but confirm
# it rather than assuming: https://docs.arc.io/arc/references/contract-addresses

NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_USDC_DECIMALS=6


# -----------------------------------------------------------------------------
# AGENTVAULT DEPLOYMENTS — filled in after `forge script Deploy`
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=


# -----------------------------------------------------------------------------
# FRONTEND (apps/web/.env.local)
# -----------------------------------------------------------------------------
# Only NON-SECRET values may carry the NEXT_PUBLIC_ prefix — anything prefixed
# this way is inlined into the browser bundle and is public. The session private
# key and the Anthropic key are server-side only and never appear here.

# Where the operator console reaches the agent runtime. A URL, not a secret.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8787

# Where the console probes service liveness. Optional: without it the Services
# page shows "not configured" for endpoint status instead of guessing.
NEXT_PUBLIC_SERVICE_API_URL=http://localhost:8788

# Optional. The injected/browser-wallet connector works without it; set it only
# if you want WalletConnect. https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# -----------------------------------------------------------------------------
# CONTRACTS (contracts/.env)  — SECRETS
# -----------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deploy.s.sol asserts block.chainid == EXPECTED_CHAIN_ID and reverts on a
# mismatch, so a stale RPC URL cannot silently deploy to the wrong network.
EXPECTED_CHAIN_ID=5042002

# SECRET. Prefer an encrypted keystore over a raw key:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer
DEPLOYER_PRIVATE_KEY=

# Constructor arg for the vault/factory (same value as NEXT_PUBLIC_USDC_ADDRESS)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional, for source verification. Arc's mainnet explorer is permissioned.
ARCSCAN_API_KEY=


# -----------------------------------------------------------------------------
# AGENT RUNTIME (apps/agent/.env)  — SECRETS
# -----------------------------------------------------------------------------
AGENT_PORT=8787
ARC_CHAIN_ID=5042002

# The vault this agent is bound to.
VAULT_ADDRESS=

# SECRET — but deliberately low-value. This key's entire authority is the
# on-chain session policy: it can call pay() and nothing else, within
# maxPerTx / dailyLimit / expiry / allowlist. It is NOT the vault owner key and
# must never be. Treat its compromise as a modelled scenario, not a disaster.
#
# Generate one: cast wallet new
AGENT_SESSION_PRIVATE_KEY=

# SECRET. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

SERVICE_BASE_URL=http://localhost:8788


# -----------------------------------------------------------------------------
# PAID DEMO SERVICE (apps/service/.env)
# -----------------------------------------------------------------------------
SERVICE_PORT=8788

# Addresses the AGENT expects each service to be paid at. These live in the
# agent's environment, not the service's, on purpose: an agent that learned
# where to pay from the party being paid has no defence against redirection.
# A quote whose payTo disagrees with these is refused before any gas is spent,
# and the vault's on-chain allowlist refuses it again regardless.
WEATHER_SERVICE_ADDRESS=
RESEARCH_SERVICE_ADDRESS=

# Where the service expects to be paid. This address must be on the session's
# on-chain recipient allowlist, or every payment to it is rejected by design.
SERVICE_PAYOUT_ADDRESS=

# Decimal USDC, e.g. 12.50 — never base units.
SERVICE_PRICE_USDC=12.50

# The service only honours payments emitted by this vault.
EXPECTED_VAULT_ADDRESS=
